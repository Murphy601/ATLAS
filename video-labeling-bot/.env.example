# Copy this file to .env and fill in real values.
# Never commit a populated .env.

OPENROUTER_API_KEY=your-actual-api-key-here

# Optional. Override the default (google/gemini-2.5-flash).
# VISION_MODEL=openai/gpt-4o-mini

# Atlas Capture audit portal you are authorized to automate
PORTAL_URL=https://audit.atlascapture.io/

# Leave empty to capture frames live from the in-page player (recommended)
SAMPLE_VIDEO=

# Review filled labels in the browser, then Submit. The bot then waits for Next task.
AUTO_SUBMIT=false

# First run must be headed so you can log in manually
HEADLESS=false

# Optional: skip Playwright and only print labels from a local file
SKIP_BROWSER=false
