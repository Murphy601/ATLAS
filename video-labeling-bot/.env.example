# Copy this file to .env and fill in real values.
# Never commit a populated .env.

OPENAI_API_KEY=your-actual-api-key-here

# Target annotation portal. Replace with the platform you are authorized to use.
PORTAL_URL=https://example-annotation-portal.com/

# Local video to process (place this file in video-labeling-bot/)
SAMPLE_VIDEO=input_video.mp4

# Set true to submit without the interactive review pause
AUTO_SUBMIT=false

# Set true for headless Chromium (required on servers without a display)
HEADLESS=false

# Optional: skip Playwright and only print generated labels
SKIP_BROWSER=false
