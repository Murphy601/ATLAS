# Atlas hybrid bot — no API key required for normal runs.

# Optional: swap MediaPipe left/right for ego (head-mounted) video
EGO_SWAP_HANDS=true

# Wrist velocity threshold (normalized 0–1 coords per frame)
HAND_MOTION_THRESHOLD=0.015

# Atlas Capture audit portal
PORTAL_URL=https://audit.atlascapture.io/

# Leave empty for live in-page capture (recommended)
SAMPLE_VIDEO=

# Review labels in browser before submit
AUTO_SUBMIT=false

# First run must be headed so you can log in manually
HEADLESS=false

# practice | assessment | auto
ATLAS_LABEL_MODE=practice

# Label from local file only (no browser)
SKIP_BROWSER=false
